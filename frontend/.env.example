# ═══════════════════════════════════════════════════════════════
# LUXE EVENTS — FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── API ────────────────────────────────────────────────────────
# Your backend URL
REACT_APP_API_URL=http://localhost:5000/api
# Production: REACT_APP_API_URL=https://your-app.onrender.com/api

# ─── Razorpay ───────────────────────────────────────────────────
# Public key ONLY — never put secret key in frontend
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx

# ─── Google Maps ────────────────────────────────────────────────
# Optional — for contact page map embed
REACT_APP_GOOGLE_MAPS_KEY=your_google_maps_browser_key
