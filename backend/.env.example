# ═══════════════════════════════════════════════════════════════
# LUXE EVENTS — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ────────────────────────────────────────────────────
# Get free cluster at https://cloud.mongodb.com
MONGO_URI=MONGO_URI=mongodb+srv://Admin:Reddy-Admin@event.5sammdl.mongodb.net/luxe-events?retryWrites=true&w=majority&appName=Event

# ─── JWT ────────────────────────────────────────────────────────
# Use a long random string — minimum 64 characters
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_replace_this
JWT_EXPIRE=7d

# ─── Razorpay ───────────────────────────────────────────────────
# Get keys at https://dashboard.razorpay.com/app/keys
# Use rzp_test_ prefix for testing, rzp_live_ for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ─── Email (SMTP) ───────────────────────────────────────────────
# Option 1: Gmail (enable 2FA then create App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# Option 2: SendGrid
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your_sendgrid_api_key

# Option 3: Mailgun
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USER=postmaster@your-domain.mailgun.org
# EMAIL_PASS=your_mailgun_smtp_password

# ─── Frontend URL ───────────────────────────────────────────────
# Used for CORS and email links
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://your-domain.vercel.app

# ─── Twilio (SMS) ───────────────────────────────────────────────
# Optional — for SMS notifications
# Get at https://console.twilio.com
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token_here
TWILIO_PHONE=+12345678901

# ─── Cloudinary (File Uploads) ──────────────────────────────────
# Optional — for image uploads
# Get at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google Maps ────────────────────────────────────────────────
# Optional — for venue maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
